# --- Required ---------------------------------------------------------------
# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
# From https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
# hh.ru requires an identifying User-Agent: "AppName/version (contact email)"
HH_USER_AGENT=JobAlertBot/1.0 (you@example.com)

# --- Optional ---------------------------------------------------------------
# Your Telegram chat id. Leave empty: the first person to send /start is registered.
TELEGRAM_CHAT_ID=
# hh.ru application access token (https://dev.hh.ru). Only needed if anonymous search gets blocked.
HH_ACCESS_TOKEN=

# Which sites to poll (comma-separated): hh.ru, rabota.by
SOURCES=hh.ru,rabota.by

# Structured search filters, applied before any scoring
SEARCH_TEXT=python
# noExperience | between1And3 | between3And6 | moreThan6 (empty = any)
SEARCH_EXPERIENCE=
# hh.ru professional role ids, comma-separated (96 = programmer/developer)
SEARCH_PROFESSIONAL_ROLES=96
# Region per site (empty = no region filter). 16 = Belarus, 113 = Russia, 1 = Moscow, 1002 = Minsk
AREA_HH_RU=
AREA_RABOTA_BY=16
# Any other /vacancies query parameters, as a query string
SEARCH_EXTRA_PARAMS=
# e.g. SEARCH_EXTRA_PARAMS=work_format=REMOTE&only_with_salary=true

SCORE_THRESHOLD=60
POLL_INTERVAL_SECONDS=300
SEARCH_PER_PAGE=50
FIRST_RUN_BATCH=10

CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# Daily heartbeat, local time
HEARTBEAT_HOUR=9
TIMEZONE=Europe/Minsk

# Where the sqlite database lives. On Railway, point this at the volume (see README).
DATA_DIR=./data
# Resume sources, in priority order: /resume in Telegram > RESUME_TEXT > RESUME_FILE
RESUME_FILE=resume.txt
RESUME_TEXT=
